# This app's own public origin (metadata, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Origin of the farm.rakhal.app app shell — the landing page's Login/Free Trial CTAs
# link here directly (RFE-100 domain split). Override for local/staging hostnames.
NEXT_PUBLIC_FARM_URL=https://farm.rakhal.app
