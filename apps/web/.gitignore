# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# permission-corrupted leftover renamed out of the way — see CURRENT_STATE.md "Known environment issue"
/node_modules.broken
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; .env.example is the template and IS committed)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual-regression gate: baselines are built in CI from the base ref, never committed
/tests/visual/.baseline
/test-results-visual
/playwright-report-visual
