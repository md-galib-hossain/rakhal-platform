{
  "name": "@rakhal/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "gen:openapi": "nest build && node dist/tools/generate-openapi.js",
    "gen:openapi:check": "nest build && node dist/tools/generate-openapi.js --check",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "test:e2e:batched": "node scripts/e2e-batches.mjs",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:dev": "prisma generate --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "redis:up": "docker compose -f docker-compose.redis.yml up -d",
    "redis:down": "docker compose -f docker-compose.redis.yml down",
    "redis:logs": "docker logs -f rakhal-redis",
    "security": "node scripts/security/run-security-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1079.0",
    "@aws-sdk/s3-request-presigner": "3.1079.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/node": "10.53.1",
    "argon2": "0.44.0",
    "bullmq": "5.76.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "nestjs-pino": "4.6.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "redis": "5.12.1",
    "reflect-metadata": "0.2.2",
    "resend": "6.12.3",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/ioredis": "5.0.0",
    "@types/jest": "30.0.0",
    "@types/multer": "2.1.0",
    "@types/node": "24.12.2",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "jest": "30.3.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../test"
    ],
    "testMatch": [
      "<rootDir>/**/*.spec.ts",
      "<rootDir>/../test/architecture.spec.ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
