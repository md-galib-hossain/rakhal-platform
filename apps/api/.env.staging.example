# Staging DB ops env — copy to .env.staging (git-ignored) and fill in.
# Consumed by: pnpm db:deploy:staging / pnpm db:reset:staging.

DATABASE_URL="postgresql://USER:PASSWORD@staging-db-host:5432/rakhal_staging?schema=public&sslmode=require"

# Staging runs the production build; the seed no longer hard-gates demo data on
# this, SEED_DEMO_DATA does.
NODE_ENV=production

# Seed the full demo farm (owner/manager/worker + herd + finance history) into
# staging. Set to false for a catalogue-only seed (permissions, roles, units,
# income categories, subscription plans, legal docs).
SEED_DEMO_DATA=true

# Demo credentials. Defaults (DemoPass123 / ManagerPass123 / WorkerPass123 /
# AdminPass123) are public knowledge — override them for any staging box that
# is reachable from the internet.
SEED_OWNER_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_WORKER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
# Base32 TOTP secret for the seeded platform admin (2FA is mandatory).
SEED_ADMIN_TOTP_SECRET=

# Required by `pnpm db:reset:staging` — must equal the target database name.
# Omit it here and pass `--confirm <db>` on the command line instead if you'd
# rather not keep a standing reset authorization in a file.
# CONFIRM_RESET=rakhal_staging
