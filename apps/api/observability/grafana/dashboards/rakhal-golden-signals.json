{
  "title": "Rakhal API - Golden Signals",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "title": "5xx Error Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),1)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "title": "p95 Latency by Route (s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le, route)) / 1000",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "Auth Failure Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(auth_failures_total[5m]))",
          "legendFormat": "failures/sec"
        }
      ]
    }
  ]
}
