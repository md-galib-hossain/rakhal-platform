model Farm {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  logo        String?
  status      FarmStatus @default(ACTIVE)

  division           String?
  district           String?
  upazila            String?
  operationalPurpose String?

  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation("FarmOwner", fields: [ownerId], references: [id])

  members           FarmMember[]
  roles             Role[]             @relation("FarmToRole")
  subscriptions     FarmSubscription[] @relation("FarmToSubscription")
  auditLogs         AuditLog[]         @relation("FarmToAuditLog")
  cattle            Cattle[]           @relation("FarmToCattle")
  breeds            Breed[]            @relation("FarmToBreed")
  sheds             Shed[]             @relation("FarmToShed")
  healthCases       HealthCase[]       @relation("FarmToHealthCase")
  healthPlans       HealthPlan[]       @relation("FarmToHealthPlan")
  healthTasks       HealthTask[]       @relation("FarmToHealthTask")
  treatmentLogs     TreatmentLog[]     @relation("FarmToTreatmentLog")
  healthUpdates     HealthUpdate[]     @relation("FarmToHealthUpdate")
  mortalityRecords  MortalityRecord[]  @relation("FarmToMortalityRecord")
  safetyWithdrawals SafetyWithdrawal[] @relation("FarmToSafetyWithdrawal")
  diseaseCatalogs   DiseaseCatalog[]   @relation("FarmToDiseaseCatalog")
  medicines         Medicine[]         @relation("FarmToMedicine")
  forages           Forage[]           @relation("FarmToForage")
  semenTanks        SemenTank[]        @relation("FarmToSemenTank")
  semenBatches      SemenBatch[]       @relation("FarmToSemenBatch")
  milkTanks         MilkTank[]         @relation("FarmToMilkTank")
  equipment         Equipment[]        @relation("FarmToEquipment")
  activityLogs      ActivityLog[]      @relation("FarmToActivityLog")
  tasks             Task[]             @relation("FarmToTask")
  milkLogEntries    MilkLogEntry[]     @relation("FarmToMilkLogEntry")
  milkBuyers        MilkBuyer[]        @relation("FarmToMilkBuyer")
  milkDispatches    MilkDispatch[]     @relation("FarmToMilkDispatch")
  financeTransactions FinanceTransaction[] @relation("FarmToFinanceTransaction")
  financeReceivables  FinanceReceivable[]  @relation("FarmToFinanceReceivable")
  financeLoans        FinanceLoan[]        @relation("FarmToFinanceLoan")
  walletTransactions  WalletTransaction[]  @relation("FarmToWalletTransaction")
  feedGroups          FeedGroup[]          @relation("FarmToFeedGroup")

  @@index([ownerId])
  @@index([slug])
}
