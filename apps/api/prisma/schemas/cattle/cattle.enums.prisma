enum CattleGender {
  MALE
  FEMALE
  CASTRATED_MALE
}

enum CattlePurpose {
  MILK
  BREEDING
  MEAT
  CALF
  BULL_SERVICE
  DUAL_PURPOSE
}

enum CattleStatus {
  ACTIVE
  SOLD
  DEAD
  TRANSFERRED
  MISSING
  ARCHIVED
  CULLED
}

/// Production dimension of the multi-state status model (PRD §8.1 / §24.2,
/// RAKHAL-269). Independent of reproduction state (`ReproductionState`) and
/// the derived health status. Trimmed to only the two real production states —
/// lifecycle/archival (sold/deceased/culled/archived) lives on `CattleStatus` +
/// `Cattle.isActive` instead (was previously overloaded onto this enum).
enum ProductionStatus {
  MILKING
  DRY
}

enum CattleSourceType {
  BORN
  PURCHASED
  GIFTED
  UNKNOWN
}

enum ShedPurpose {
  MILKING
  HEIFER
  DRY
  CALF
  QUARANTINE
  GENERAL
}
