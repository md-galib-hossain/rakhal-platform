model Cattle {
  id String @id @default(cuid())

  farmId String

  name      String?
  tagNumber String
  image     String?

  breedId     String?
  gender      CattleGender
  dateOfBirth DateTime?
  purpose     CattlePurpose
  status      CattleStatus  @default(ACTIVE)
  shedId      String?

  motherId String?
  fatherId String?

  sourceType CattleSourceType @default(UNKNOWN)
  color      String?
  notes      String?

  /// Animal Quality Rating (0–100), event-driven via the AQR engine (PRD §19.2,
  /// §25.7). Null = nullified (e.g. on mortality); excluded from the herd mean.
  aqrScore Float? @default(0)

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm    Farm   @relation("FarmToCattle", fields: [farmId], references: [id])
  breed   Breed? @relation(fields: [breedId], references: [id])
  shed    Shed?  @relation(fields: [shedId], references: [id])
  creator User   @relation("CattleCreator", fields: [createdBy], references: [id])

  mother   Cattle?  @relation("CattleMother", fields: [motherId], references: [id])
  motherOf Cattle[] @relation("CattleMother")
  father   Cattle?  @relation("CattleFather", fields: [fatherId], references: [id])
  fatherOf Cattle[] @relation("CattleFather")

  reproductionProfile ReproductionProfile?
  heatEvents          HeatEvent[]
  breedingEvents      BreedingEvent[]      @relation("BreedingEventCattle")
  breedingAsBull      BreedingEvent[]      @relation("BreedingEventBull")
  pregnancyDiagnoses  PregnancyDiagnosis[]
  pregnancies         Pregnancy[]
  calvingEvents       CalvingEvent[]
  abortionEvents      AbortionEvent[]
  dryPeriods          DryPeriod[]
  lactations          Lactation[]
  calfBirths          CalfBirth[]          @relation("CattleCalfBirth")
  calfColostrumRecords   CalfColostrumRecord[]
  calfMilkFeedings       CalfMilkFeeding[]
  calfWeightRecords      CalfWeightRecord[]
  calfStarterFeedRecords CalfStarterFeedRecord[]
  calfWeaningRecord      CalfWeaningRecord?
  healthCases         HealthCase[]
  healthTasks         HealthTask[]
  treatmentLogs       TreatmentLog[]
  healthUpdates       HealthUpdate[]
  mortalityRecords    MortalityRecord[]
  safetyWithdrawals   SafetyWithdrawal[]

  @@unique([farmId, tagNumber])
  @@index([farmId])
  @@index([breedId])
  @@index([shedId])
  @@index([status])
  @@index([motherId])
  @@index([fatherId])
  @@index([createdBy])
}

model Breed {
  id String @id @default(cuid())

  farmId      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm   Farm     @relation("FarmToBreed", fields: [farmId], references: [id])
  cattle Cattle[]

  @@unique([farmId, name])
  @@index([farmId])
}

model Shed {
  id String @id @default(cuid())

  farmId      String
  name        String
  code        String
  description String?
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm        Farm         @relation("FarmToShed", fields: [farmId], references: [id])
  cattle      Cattle[]
  healthCases HealthCase[]

  @@unique([farmId, code])
  @@index([farmId])
}
