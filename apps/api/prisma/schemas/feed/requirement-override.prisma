/// A cow's hand-set nutrition requirement (MILESTONE 28, RAKHAL-460, PRD §12.17, ADR-028).
///
/// **Manual is on** for a cow exactly when she has a row with `effectiveTo IS NULL`; there is no separate
/// boolean. While on, the calculated requirement does not apply to her at all. Rows are immutable apart
/// from being closed: changing the values closes the open row (`REPLACED`) and opens a new one, turning
/// manual off closes it (`TURNED_OFF`). `effectiveFrom` is always the server's `now()` — no backdating.
model CattleRequirementOverride {
  id       String @id @default(cuid())
  farmId   String
  cattleId String

  dmKg Float
  cpKg Float
  meMj Float
  note String?

  /// MILESTONE 28b (RAKHAL-463): the rest of the nutrient profile, hand-set. All nullable because rows saved
  /// under v1 have only DM/CP/ME — a null falls back to the v1 rule (`requirementsFromManual`). A v2 row has
  /// every one of them set. CP %, energy density, NEL and Ca:P are derived, never stored.
  ndfKg        Float?
  ndfMaxKg     Float?
  adfKg        Float?
  fatKg        Float?
  tdnKg        Float?
  calciumKg    Float?
  phosphorusKg Float?
  rdpPct       Float?
  rupPct       Float?

  /// Engine output + inputs + animal type when this row was set, used for the staleness warning (D6).
  /// Shape: { dm_kg, cp_kg, me_mj, animal_type, inputs: {...} } — the same snake_case as `forCattle`.
  dynamicSnapshot Json

  effectiveFrom DateTime                      @default(now())
  effectiveTo   DateTime?
  endReason     RequirementOverrideEndReason?

  setBy     String
  endedBy   String?
  createdAt DateTime @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id])
  cattle Cattle @relation(fields: [cattleId], references: [id])

  @@index([farmId, cattleId, effectiveFrom])
  // Raw SQL in the migration (same technique as `FeedPlanAssignment`): a partial unique index — at most one
  // open row per (farmId, cattleId) WHERE "effectiveTo" IS NULL — and
  // CHECK ("dmKg" > 0 AND "cpKg" > 0 AND "meMj" > 0 AND "cpKg" < "dmKg").
}

enum RequirementOverrideEndReason {
  REPLACED
  TURNED_OFF
}
