/// Feed Formulator (PRD §12 / API §8). Farms price ingredients, compute a
/// cow/group's nutritional requirements, and build concentration formulas.
///
/// The ingredient catalogue is **Rakhal-Admin-managed** but the Admin panel is
/// not built yet, so `FeedIngredient` is a seeded global catalogue (no `farmId`,
/// `isSystemDefault`) — the same pattern as `DiseaseCatalog` / the AQR config
/// seam. RAKHAL-110 will later sync it from the real Admin. Farms layer
/// per-org price/nutrition overrides on top via `FeedIngredientOverride`.

model FeedIngredient {
  id String @id @default(cuid())

  nameEn   String
  nameBn   String?
  category FeedIngredientCategory

  /// Standard nutritional values per kg (§4.1 / §24.11). Unless noted, every
  /// `xPct` is a rate on **dry matter** (% of DM) — `rdpPct`/`rupPct` are the one
  /// exception, conventionally expressed as **% of CP** (NRC/INRA: RDP%+RUP% ≈
  /// 100% of crude protein, partitioning CP into rumen-degradable/undegradable
  /// fractions), never confuse the two bases when computing a kg contribution
  /// (`formula-math.ts` derives `rdp_kg`/`rup_kg` off `cp_kg`, not `dm_kg`).
  dmPct        Float // Dry Matter %
  cpPct        Float // Crude Protein % of DM
  rdpPct       Float? // Rumen-Degradable Protein, % of CP
  rupPct       Float? // Rumen-Undegradable Protein, % of CP
  meMjPerKgDm  Float // Metabolizable Energy (MJ/kg DM)
  fatPct       Float? // Ether Extract, % of DM
  starchPct    Float? // % of DM
  ndfPct       Float? // Neutral Detergent Fiber, % of DM
  adfPct       Float? // Acid Detergent Fiber, % of DM
  calciumPct   Float? // % of DM
  phosphorusPct Float? // % of DM
  tdnPct       Float? // Total Digestible Nutrients, % of DM
  sugarsPct    Float?

  nutritionSource  String? // e.g. INRA 2018 / NRC 2001 / BAU
  currentPricePerKg Float // Tk/kg, Admin-updated weekly
  priceUpdatedAt    DateTime?

  isAvailableBd   Boolean @default(true)
  isSystemDefault Boolean @default(false)
  isActive        Boolean @default(true)

  /// Farm-added "quick" ingredient (frontend "Add Custom Ingredient", RAKHAL-feed-custom): `null`
  /// = the global Rakhal-Admin catalogue (unchanged, `farmId` never set on those rows), non-null =
  /// this one farm's own row, invisible to every other farm (`feed-ingredient.service.ts#listMerged`
  /// scopes the query). A farm quick-add has **no known nutrition breakdown** (the user only
  /// supplies a name/nutrientGroup/price, not lab values) — `dmPct` defaults to 100 (the whole
  /// entered weight counts as dry matter, the simplest honest assumption when moisture is unknown)
  /// and every other nutrient stays 0, so it contributes real ৳ cost to a formula without a
  /// fabricated nutrient contribution. `nutrientGroup` is a **display-only** tag (which of the
  /// table's Protein/Energy/Fiber column groups to color it under) — it does not feed any formula
  /// math, unlike `cpPct`/`meMjPerKgDm`/`ndfPct` which do.
  farmId        String?
  nutrientGroup FeedNutrientGroup?

  /// Set only for an ingredient row **promoted from a finalized concentration**
  /// (`FeedConcentrationService.finalize`, "concentrate as reusable ingredient" —
  /// user request 2026-07-17). As of 2026-07-18 (user request: editing a Concentrate
  /// Mixer must live-propagate to every TMR using it) this row is **kept in sync
  /// with the source concentration on every save** rather than frozen — `finalize()`
  /// upserts by `sourceConcentrationId` (update in place if one already exists, only
  /// creates a new row the first time), and a plain `update()` on an already-finalized
  /// template refreshes this row's nutrition/price too, with no extra click needed.
  /// `sourceConcentrationVersion`/`isLatestVersion` are now vestigial sentinels (always
  /// `1`/`true` on the one promoted row per concentration) — the version-history
  /// mechanic they used to drive was retired along with the frozen-snapshot behavior;
  /// kept only because `FeedStock.sourceConcentrationVersion` still references the
  /// column shape.
  sourceConcentrationId      String?
  sourceConcentrationVersion Int?
  isLatestVersion            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm                Farm?                    @relation("FarmToCustomFeedIngredient", fields: [farmId], references: [id])
  overrides           FeedIngredientOverride[]
  concentrationItems  FeedConcentrationItem[]
  sourceConcentration FeedConcentration?       @relation(fields: [sourceConcentrationId], references: [id])

  @@index([category])
  @@index([isActive])
  @@index([farmId])
  @@index([sourceConcentrationId])
}

model FeedIngredientOverride {
  id           String @id @default(cuid())
  farmId       String
  ingredientId String

  /// null on any field = fall through to the Admin/standard value. Basis matches
  /// `FeedIngredient`'s doc comment (rdp/rup = % of CP, everything else = % of DM).
  customPricePerKg Float?
  customDmPct      Float?
  customCpPct      Float?
  customMeMjPerKgDm Float?
  customFatPct     Float?
  customNdfPct     Float?
  customRdpPct       Float?
  customRupPct       Float?
  customStarchPct    Float?
  customAdfPct       Float?
  customCalciumPct   Float?
  customPhosphorusPct Float?
  customTdnPct       Float?
  notes            String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm           @relation("FarmToFeedIngredientOverride", fields: [farmId], references: [id])
  ingredient FeedIngredient @relation(fields: [ingredientId], references: [id])

  @@unique([farmId, ingredientId])
  @@index([farmId])
}

/// A concentration template = a feed formula targeted at a feed group (or a
/// single cow). `feedGroupId`/`cattleId` are plain validated FKs (resolved in
/// the service) to avoid coupling to the Settings-owned `FeedGroup`/`Cattle`.
model FeedConcentration {
  id     String @id @default(cuid())
  farmId String

  /// Explicit discriminator (user request 2026-07-18 — "why does creating a concentrate add to my
  /// feeds"): previously the only signal separating a reusable concentrate recipe from a cow-targeted
  /// feed mixture was whether `targetWeightKg`/`targetMilkL` happened to be set, but the frontend's
  /// create form required both fields unconditionally for every concentration, so everything always
  /// landed as a mixture regardless of intent. `kind` is now set explicitly at creation and is
  /// immutable afterwards — a `CONCENTRATE_TEMPLATE` never carries a target (enforced in
  /// `FeedConcentrationService.create`, not just DTO validation) and can be promoted into a reusable
  /// ingredient via `finalize()`; a `FEED_MIXTURE` always carries a target and is the thing actually
  /// fed to a cow/group.
  kind FeedConcentrationKind

  name          String
  durationDays  Int?
  targetType    FeedTargetType @default(GROUP)
  feedGroupId   String?
  cattleId      String?
  targetWeightKg Float?
  targetMilkL    Float?

  /// Vestigial as of 2026-07-18 — `finalize()` no longer bumps this (the
  /// version-history mechanic it drove was retired in favor of live-sync, see
  /// `FeedIngredient.sourceConcentrationVersion`'s doc comment). Left in place
  /// rather than dropped since it's unused by any code path, confirmed via a
  /// full-frontend grep; safe to remove in a future cleanup pass.
  versionNumber Int @default(1)

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm                Farm                    @relation("FarmToFeedConcentration", fields: [farmId], references: [id])
  items               FeedConcentrationItem[]
  promotedIngredients FeedIngredient[]
  stocks              FeedStock[]

  @@index([farmId])
  @@index([farmId, feedGroupId])
}

model FeedConcentrationItem {
  id              String @id @default(cuid())
  concentrationId String
  ingredientId    String

  amountKg Float

  concentration FeedConcentration @relation(fields: [concentrationId], references: [id], onDelete: Cascade)
  ingredient    FeedIngredient    @relation(fields: [ingredientId], references: [id])

  @@index([concentrationId])
  @@index([ingredientId])
}

/// Daily feed distribution log (PRD §12.5, V1.5). After a concentration formula
/// is applied to a group, the actual quantities distributed are logged per
/// ingredient (pre-filled from the formula's planned amounts, editable), with any
/// refusal/leftover. Total cost is computed from actual quantities at the farm's
/// effective ingredient prices (snapshotted on each line). Matching forage stock
/// decrements best-effort (§15.3) by ingredient name, kg-unit forages only.
model FeedDistribution {
  id String @id @default(cuid())

  farmId          String
  concentrationId String
  /// Denormalized from the concentration at log time — exactly one of these two is set, matching
  /// the source TMR's own `targetType` (GROUP → `feedGroupId`, INDIVIDUAL → `cattleId`). Added
  /// 2026-07-18 (Phase 12.4, user request — "feed a single cow, not just a group") alongside
  /// `feedGroupId`, which predates this and was the only target this model supported until now.
  feedGroupId String?
  cattleId    String?

  distributedAt DateTime /// the day the feed was distributed

  totalPlannedKg   Float @default(0)
  totalActualKg    Float @default(0)
  totalRefusalKg   Float @default(0)
  totalPlannedCost Float @default(0)
  totalActualCost  Float @default(0)

  notes String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm  Farm                   @relation("FarmToFeedDistribution", fields: [farmId], references: [id])
  items FeedDistributionItem[]

  @@index([farmId])
  @@index([farmId, feedGroupId])
  @@index([farmId, cattleId])
  @@index([farmId, distributedAt])
}

model FeedDistributionItem {
  id             String @id @default(cuid())
  distributionId String

  /// Plain snapshot of the catalogue ingredient (no relation — the line keeps its
  /// own name + price so history survives later catalogue edits).
  ingredientId   String
  ingredientName String

  plannedKg  Float
  actualKg   Float
  refusalKg  Float @default(0)
  pricePerKg Float
  lineCost   Float /// actualKg * pricePerKg

  distribution FeedDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  @@index([distributionId])
  @@index([ingredientId])
}

enum FeedIngredientCategory {
  ROUGHAGE
  CONCENTRATE
  SILAGE
  SUPPLEMENT
  BY_PRODUCT
}

enum FeedTargetType {
  GROUP
  INDIVIDUAL
}

/// See `FeedConcentration.kind`'s doc comment.
enum FeedConcentrationKind {
  CONCENTRATE_TEMPLATE
  FEED_MIXTURE
}

/// Display-only classification for a farm's quick-add custom ingredient (see `FeedIngredient`'s
/// doc comment) — which of the ingredient table's 3 column groups to tag/color it under.
enum FeedNutrientGroup {
  PROTEIN
  ENERGY
  FIBER
}
