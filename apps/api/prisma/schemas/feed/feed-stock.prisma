/// Feed batch inventory (§12.5 follow-up, "TMR ↔ Inventory" — user request 2026-07-17). A
/// `FeedStock` lot is created when a farm **finalizes** a `FeedConcentration` (produces a real
/// physical batch, `FeedConcentrationService.finalize`), tracking how much of that specific batch
/// remains. This is a farm-*manufactured* good — a different lifecycle from the Inventory module's
/// `Forage` (a *purchased* good with supplier/moisture/purchase-date fields) — so it's a new,
/// purpose-built model owned by the Feed module, following the same "each physical resource is its
/// own model + service" convention as `Medicine`/`SemenBatch` (not a generic `InventoryItem`, which
/// has no precedent anywhere in this codebase).
model FeedStock {
  id     String @id @default(cuid())
  farmId String

  /// RAKHAL-421: which finalize path produced this lot — a Concentrate Mixer's virtual recipe
  /// (`CONCENTRATE_TEMPLATE`, no purchase, no cash movement) vs. a real Total Mixed Ration
  /// (`FEED_MIXTURE`). Defaulted to `FEED_MIXTURE` so the migration backfills every pre-existing
  /// row correctly — all prior lots were TMR by construction, `CONCENTRATE_TEMPLATE` batches only
  /// existed as `FeedItem` rows before this ticket (see `prisma/rakhal-421-migrate-concentrate-feeditems.ts`).
  kind FeedConcentrationKind @default(FEED_MIXTURE)

  sourceConcentrationId      String
  sourceConcentrationVersion Int

  producedAt     DateTime
  producedQtyKg  Float
  currentStockKg Float
  producedCostTk Float /// snapshot of the formula's total_cost_tk at production time

  /// RAKHAL-451 (MILESTONE 26, D12): this lot's nutrition-of-record is an immutable `NutritionProfile`
  /// (same definition a purchased `FeedItemBatch` uses) instead of 12 inline columns + source/ref.
  /// Seeded at finalize from the recipe's computed totals (`REFERENCE`, not measured); a lab result
  /// appends a superseding profile (`FeedStockService.updateNutrition`) — never an in-place edit.
  nutritionProfileId String

  /// Soft-delete (user request 2026-07-19 — "form inventory it can be also deleted"), same
  /// archive-not-hard-delete convention as every other inventory model. Never filtered out of
  /// `get()`/movement history, only from the default `list()`.
  deletedAt DateTime?

  createdBy String
  createdAt DateTime @default(now())

  farm             Farm                @relation("FarmToFeedStock", fields: [farmId], references: [id])
  concentration    FeedConcentration   @relation(fields: [sourceConcentrationId], references: [id])
  nutritionProfile NutritionProfile    @relation("FeedStockNutritionProfile", fields: [nutritionProfileId], references: [id])
  movements        FeedStockMovement[]

  @@index([farmId])
  @@index([sourceConcentrationId])
  @@index([nutritionProfileId])
}

/// Audit trail for `FeedStock.currentStockKg` changes — mirrors `MedicineStockMovement`'s pattern.
model FeedStockMovement {
  id      String @id @default(cuid())
  stockId String

  changeKg Float /// positive = produced, negative = consumed
  reason   FeedStockMovementReason

  /// Plain scalar, no FK (mirrors `FeedDistributionItem.ingredientName`'s "snapshot, not a
  /// relation" convention) — a FED movement references the distribution that consumed it.
  distributionId String?

  createdBy String
  createdAt DateTime @default(now())

  stock FeedStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
}

enum FeedStockMovementReason {
  PRODUCED
  FED
  ADJUSTMENT
}
