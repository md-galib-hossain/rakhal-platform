enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  FAILED
  VOID
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

/// The payment gateway an attempt ran through. `NONE` = ৳0 invoice (no gateway);
/// `MANUAL` = admin-recorded; `BKASH` = the tokenized-checkout adapter (RAKHAL-221).
enum PaymentGateway {
  NONE
  MANUAL
  BKASH
}

/// RAKHAL-222, PRD §33.1. `FREE_DAYS` is priced as a full-subtotal discount for
/// MVP (a "free period" invoice) — a mid-cycle period-extension semantic is
/// deferred until a ticket needs it.
enum CouponType {
  PERCENT
  FIXED
  FREE_DAYS
}

enum CouponStatus {
  ACTIVE
  DISABLED
}
