model ReproductionProfile {
  id       String @id @default(cuid())
  cattleId String @unique

  pubertyDate DateTime?

  /// Core breeding-cycle state (RAKHAL-271 v2). Nullable, **no default** — a
  /// cow that was `DRY`/`LACTATING`/`HEIFER` under the old v1 enum is very
  /// often still pregnant or fertile, so the migration does not CASE-guess a
  /// value (a DB-level default would silently backfill every existing row on
  /// `ADD COLUMN`, which is exactly the fabricated-fertility-data bug this
  /// correction fixes). `prisma/backfill-reproduction-state.ts` re-derives the
  /// real state per-cow from actual event history, leaving genuinely
  /// ambiguous rows `NULL` ("not assessed") rather than guessing; new rows get
  /// a real value from the first `refreshProfile()` call. Field name kept as
  /// `reproductiveStatus` (only the type changed) to minimize call-site churn.
  reproductiveStatus     ReproductionState?
  currentLactationNumber Int                @default(0)

  totalBreedings   Int @default(0)
  totalPregnancies Int @default(0)
  totalCalvings    Int @default(0)
  totalAbortions   Int @default(0)

  firstCalvingDate       DateTime?
  lastBreedingDate       DateTime?
  lastPregnancyCheckDate DateTime?
  lastCalvingDate        DateTime?
  currentPregnancyId     String?
  currentLactationId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cattle Cattle @relation(fields: [cattleId], references: [id])
}

model HeatEvent {
  id       String @id @default(cuid())
  cattleId String

  heatDateTime DateTime

  detectionMethod  HeatDetectionMethod
  standingHeat     Boolean             @default(false)
  mucusDischarge   Boolean             @default(false)
  mountingBehavior Boolean             @default(false)
  restlessness     Boolean             @default(false)

  notes String?

  createdAt DateTime @default(now())

  cattle Cattle @relation(fields: [cattleId], references: [id])

  @@index([cattleId])
  @@index([heatDateTime])
}

model BreedingEvent {
  id       String @id @default(cuid())
  cattleId String

  breedingDate DateTime

  breedingMethod BreedingMethod
  bullId         String?
  semenBatchId   String?
  inseminator    String?

  breedingNumber             Int
  expectedPregnancyCheckDate DateTime?
  status                     BreedingStatus @default(PENDING_CHECK)
  notes                      String?

  createdAt DateTime @default(now())

  cattle Cattle  @relation("BreedingEventCattle", fields: [cattleId], references: [id])
  bull   Cattle? @relation("BreedingEventBull", fields: [bullId], references: [id])

  diagnoses   PregnancyDiagnosis[]
  pregnancies Pregnancy[]

  @@index([cattleId])
  @@index([bullId])
  @@index([breedingDate])
  @@index([status])
}

model PregnancyDiagnosis {
  id              String  @id @default(cuid())
  cattleId        String
  breedingEventId String?

  diagnosisDate       DateTime
  result              PregnancyDiagnosisResult
  diagnosisMethod     PregnancyDiagnosisMethod
  gestationDay        Int?
  expectedCalvingDate DateTime?
  notes               String?

  createdAt DateTime @default(now())

  cattle        Cattle         @relation(fields: [cattleId], references: [id])
  breedingEvent BreedingEvent? @relation(fields: [breedingEventId], references: [id])

  @@index([cattleId])
  @@index([breedingEventId])
  @@index([diagnosisDate])
  @@index([result])
}

model Pregnancy {
  id              String  @id @default(cuid())
  cattleId        String
  breedingEventId String?

  conceptionDate      DateTime
  expectedCalvingDate DateTime?
  actualCalvingDate   DateTime?
  gestationDays       Int?
  status              PregnancyStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  cattle        Cattle         @relation(fields: [cattleId], references: [id])
  breedingEvent BreedingEvent? @relation(fields: [breedingEventId], references: [id])

  calvingEvents  CalvingEvent[]
  abortionEvents AbortionEvent[]

  @@index([cattleId])
  @@index([breedingEventId])
  @@index([status])
}

model CalvingEvent {
  id          String  @id @default(cuid())
  cattleId    String
  pregnancyId String?

  calvingDate      DateTime
  calvingNumber    Int
  calvingEase      CalvingEase
  calfCount        Int         @default(1)
  placentaExpelled Boolean     @default(false)
  retainedPlacenta Boolean     @default(false)
  complications    String?
  notes            String?

  createdAt DateTime @default(now())

  cattle    Cattle     @relation(fields: [cattleId], references: [id])
  pregnancy Pregnancy? @relation(fields: [pregnancyId], references: [id])

  calfBirths CalfBirth[]
  lactations Lactation[]

  @@index([cattleId])
  @@index([pregnancyId])
  @@index([calvingDate])
}

model CalfBirth {
  id             String  @id @default(cuid())
  calvingEventId String
  calfId         String?

  gender      CattleGender
  birthWeight Decimal?
  status      CalfBirthStatus

  createdAt DateTime @default(now())

  calvingEvent CalvingEvent @relation(fields: [calvingEventId], references: [id])
  calf         Cattle?      @relation("CattleCalfBirth", fields: [calfId], references: [id])

  @@index([calvingEventId])
  @@index([calfId])
}

model AbortionEvent {
  id          String  @id @default(cuid())
  cattleId    String
  pregnancyId String?

  abortionDate   DateTime
  gestationDay   Int?
  suspectedCause String?
  notes          String?

  createdAt DateTime @default(now())

  cattle    Cattle     @relation(fields: [cattleId], references: [id])
  pregnancy Pregnancy? @relation(fields: [pregnancyId], references: [id])

  @@index([cattleId])
  @@index([pregnancyId])
  @@index([abortionDate])
}

model DryPeriod {
  id       String @id @default(cuid())
  cattleId String

  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  notes           String?

  /// RAKHAL-274: optional reason for the dry-off; nullable, no default.
  reason DryOffReason?

  createdAt DateTime @default(now())

  cattle Cattle @relation(fields: [cattleId], references: [id])

  @@index([cattleId])
  @@index([startDate])
}

model Lactation {
  id              String  @id @default(cuid())
  cattleId        String
  lactationNumber Int
  calvingEventId  String?

  startDate    DateTime
  endDate      DateTime?
  peakMilkDate DateTime?
  status       LactationStatus @default(ACTIVE)

  /// Why this lactation began (RAKHAL-271 v2 correction). Replaces the
  /// rejected `Cattle.lactationStartDate` — this is now the sole source of
  /// truth for lactation start. Defaults `CALVING` (safe for the migration
  /// backfill of existing rows — every pre-existing `Lactation` row genuinely
  /// came from a calving).
  startReason         LactationStartReason @default(CALVING)
  /// The `CalvingEvent` that produced this lactation, when `startReason` is
  /// `CALVING` (redundant with `calvingEventId` for that case, but kept
  /// distinct/nullable so `PURCHASE_IMPORT`/`MANUAL_CORRECTION` lactations —
  /// which have no `calvingEventId` — still have an explicit, typed home for
  /// provenance instead of overloading `calvingEventId`).
  sourceCalvingEventId String?

  /// RAKHAL-281: why this lactation ended. Nullable, set only when
  /// `status=ENDED` — `recordDryOff()` doesn't set this yet (RAKHAL-290).
  endReason LactationEndReason?

  /// RAKHAL-281: purchased-lactating intake (`startReason:
  /// PURCHASED_LACTATING`) has no `CalvingEvent` to derive DIM/lactation
  /// number from — `isEstimated` flags that this lactation's DIM/number are
  /// farmer-supplied estimates, never silently treated as verified.
  /// `estimatedLactationNumber`/`estimatedDaysInMilk` capture what was
  /// supplied at intake time (both null if the farmer supplied nothing),
  /// kept distinct from the real `lactationNumber`/derived-DIM fields so a
  /// later correction can't retroactively rewrite what was originally known.
  isEstimated              Boolean @default(false)
  estimatedLactationNumber Int?
  estimatedDaysInMilk      Int?

  createdAt DateTime @default(now())

  cattle       Cattle        @relation(fields: [cattleId], references: [id])
  calvingEvent CalvingEvent? @relation(fields: [calvingEventId], references: [id])

  @@index([cattleId])
  @@index([calvingEventId])
  @@index([status])
}
