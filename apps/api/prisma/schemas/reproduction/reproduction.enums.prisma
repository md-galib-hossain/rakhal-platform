/// Pure breeding-cycle CORE state (RAKHAL-271, v2 correction). Deliberately
/// excludes lactation state — `DRY`/`LACTATING` moved to
/// `Cattle.productionStatus` (RAKHAL-269), `POSTPARTUM`/`RETIRED` (dead —
/// never written) and `HEIFER`/`ABORTED` were dropped as terminal/redundant
/// states. `refreshProfile()` always derives one of these 5 values, never
/// leaving the cow in a dead-end status.
///
/// v2 split (see `docs/PROJECT_PROGRESS.md` MILESTONE 10 + the v1→v2 plan):
/// this used to be an 8-value `ReproductiveStatus` that also encoded
/// time-bound alerts (`IN_HEAT`/`PREGNANCY_CHECK_DUE`/`EXPECTED_TO_CALVE`) as
/// if they were core states — a pregnant cow near calving is still PREGNANT,
/// not a different state. Those three moved to the derived (not stored)
/// `ReproductionAlert[]` (`src/modules/reproduction/domain/reproduction-alerts.ts`).
/// `INSEMINATED` was renamed to `BRED_AWAITING_CONFIRMATION` — clearer that
/// it's a waiting state, not an event type.
enum ReproductionState {
  NOT_ELIGIBLE
  POSTPARTUM_WAITING
  OPEN
  BRED_AWAITING_CONFIRMATION
  PREGNANT
}

/// Why a `Lactation` row began (RAKHAL-271 v2 correction). Replaces the
/// rejected `Cattle.lactationStartDate` (a duplicate source of truth against
/// `Lactation.startDate`, dropped by RAKHAL-269's v2 correction) — lactation
/// start now lives solely on `Lactation`.
///
/// RAKHAL-281 (breaking rename): `PURCHASE_IMPORT` → `PURCHASED_LACTATING`
/// (clearer — this is a live purchased-cow intake, not a data import) +
/// new `HISTORICAL_IMPORT` (paper-record migration into the system, a
/// distinct provenance from a purchased-cow intake). Migration renames the
/// Postgres enum value in place (`ALTER TYPE ... RENAME VALUE`), so every
/// existing row's data is preserved with no separate backfill needed.
enum LactationStartReason {
  CALVING
  PURCHASED_LACTATING
  HISTORICAL_IMPORT
  MANUAL_CORRECTION
}

/// RAKHAL-281: why a `Lactation` row ended. Nullable on `Lactation`, set only
/// when `status=ENDED` — a still-`ACTIVE` lactation has no end reason yet.
/// `MISSING_DRY_OFF_RECORD` covers RAKHAL-290's future auto-close case (a new
/// calving found while the prior lactation was never explicitly dried off).
enum LactationEndReason {
  DRY_OFF
  SOLD
  CULLED
  DEATH
  MANUAL_CORRECTION
  MISSING_DRY_OFF_RECORD
}

enum HeatDetectionMethod {
  VISUAL
  COLLAR_SENSOR
  PEDOMETER
  MANUAL
}

/// RAKHAL-298: why an open `HeatEvent` was closed. No `EXPIRED` — expiry is a
/// pure function of (heatDateTime, now, reproHeatWindowDays), not a stored
/// state (see docs/REPRODUCTION_CORRECTIONS_DESIGN.md §2.2).
enum HeatResolutionReason {
  INSEMINATED
  FALSE_ALARM
  SKIPPED_CYCLE
}

enum BreedingMethod {
  AI
  NATURAL
  EMBRYO_TRANSFER
}

enum BreedingStatus {
  PENDING_CHECK
  PREGNANT
  FAILED
  ABORTED
  CALVED
}

enum PregnancyDiagnosisResult {
  PREGNANT
  NOT_PREGNANT
  SUSPECTED
}

enum PregnancyDiagnosisMethod {
  ULTRASOUND
  PALPATION
  LAB
  /// RAKHAL-307: cattle-intake declaration ("she is already pregnant" at
  /// purchase) — doubles as the "estimated" flag for that synthetic
  /// diagnosis row, no new column needed.
  PURCHASE_INTAKE
}

enum PregnancyStatus {
  ACTIVE
  CALVED
  ABORTED
  FAILED
}

enum CalvingEase {
  NORMAL
  ASSISTED
  DIFFICULT
  CESAREAN
}

enum CalfBirthStatus {
  ALIVE
  STILLBORN
  DIED_AFTER_BIRTH
}

enum LactationStatus {
  ACTIVE
  ENDED
}

/// RAKHAL-274: why a cow was dried off. Nullable on `DryPeriod` — optional,
/// no default (unknown historical reason should stay null, not guess).
enum DryOffReason {
  SCHEDULED
  LOW_PRODUCTION
  HEALTH
  PREGNANCY
  MANAGEMENT_DECISION
}
