/// A commercial sale document — the root of every farm sale (milk/animal/inventory/
/// manure), RAKHAL-339, Sales module — `FINANCE_V2_DESIGN.md` §4.3, §5.1.
///
/// **Real typed detail tables, not a polymorphic `referenceId` string** — this is
/// the design doc's own core decision (§5.1): `SaleLine.type` discriminates which of
/// `MilkSaleLine`/`AnimalSaleLine`/`InventorySaleLine`/`ManureSaleLine` (sale-line.prisma)
/// carries the real foreign key for that line.
///
/// **This ticket's scope is the document model + persistence + numbering only** — no
/// journal posting, no `Receivable`, no stock decrement. Those are RAKHAL-340
/// (Receivable v2) and the per-sale-type use cases (RAKHAL-342/345/346/347), which call
/// `SaleService.createSale` as their first atomic step and then continue the same
/// `$transaction` with their own stock/ledger side effects.
///
/// **`customerId` — real FK as of RAKHAL-364 (MILESTONE 22, `BUSINESS_IA_PRD.md`
/// §7).** Was a plain nullable scalar because no generic `Customer` entity existed;
/// now points at `MilkBuyer` (`prisma/schemas/buyer/buyer.prisma`) — the **model
/// keeps its name** (buyer-directory vocabulary), the **relation field is named
/// `customer`** (sales vocabulary), one alias, not a rename (rejected as churn —
/// `BUSINESS_IA_PRD.md` §7.5). Stays **nullable**: a walk-up cash sale, a manure
/// sale (RD-058) and every Other Income row legitimately have no buyer.
/// `onDelete: Restrict` — buyers are archived via `MilkBuyer.isActive`, never
/// hard-deleted, so a sale can never point at a gone row. **A Prisma FK cannot
/// enforce `Sale.farmId == MilkBuyer.farmId`** — `SaleService.createWithClient`
/// asserts that in the application layer before every write; skipping that assert
/// would let this FK open a cross-tenant hole it did not have as a bare scalar.
model Sale {
  id     String @id @default(cuid())
  farmId String

  /// Human-readable document number, e.g. `SALE-000123` — allocated via the existing
  /// `FarmCounter` model (`prisma/schemas/farm/farm-counter.prisma`), never
  /// `count()+1` (the V1 race this milestone exists to fix, `finance.service.ts:1014-1023`).
  /// See `sale-number.ts` for the exact format + allocation helper.
  saleNumber String

  /// FK column backing the `customer` relation below — see this model's own doc
  /// comment for the naming-alias rationale.
  customerId String?

  saleDate DateTime

  subtotal       Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  /// `subtotal - discountAmount`, computed by `SaleService` at create time (not a
  /// generated column — Decimal generated columns are out of scope here).
  totalAmount Decimal @db.Decimal(18, 2)

  status SaleStatus @default(DRAFT)
  notes  String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm  Farm       @relation("FarmToSale", fields: [farmId], references: [id])
  lines SaleLine[]

  /// The `Receivable` raised for this sale, if any (RAKHAL-340) — a sale
  /// paid in full at creation has none. One-to-one: `Receivable.saleId` is
  /// `@unique`.
  receivable Receivable? @relation("SaleToReceivable")

  /// RAKHAL-364 — the buyer/customer, if any. See this model's own doc
  /// comment for the `customer`-field/`MilkBuyer`-model naming alias.
  customer MilkBuyer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([farmId, saleNumber])
  @@index([farmId])
  @@index([farmId, saleDate])
  @@index([farmId, status])
  @@index([farmId, customerId])
}
