/// Account-to-account money movement (RAKHAL-338, Finance V2 —
/// `FINANCE_V2_DESIGN.md` §4.4). A transfer moves money the farm already has
/// from one `FinancialAccount` to another — it produces **no revenue, no
/// expense and no profit change**, except an optional `feeAmount`, which
/// posts to the seeded "Transfer Fee" system `LedgerAccount` (code `5500`,
/// `default-chart-of-accounts.ts`) as a real expense.
///
/// Worked example (`FINANCE_V2_DESIGN.md` §4.4, this ticket's own AC): a
/// ৳10,000 transfer from bKash to Bank with a ৳100 fee leaves Bank +10,000,
/// bKash −10,100, Transfer Fee Expense +100 — see `TransferService`'s doc
/// comment for the exact journal lines that produce this.
model Transfer {
  id     String @id @default(cuid())
  farmId String

  /// Source `FinancialAccount` — must differ from `toFinancialAccountId`
  /// (`TransferService.createTransfer` rejects a same-account transfer) and
  /// must hold `>= amount + feeAmount` at the time of transfer.
  fromFinancialAccountId String
  /// Destination `FinancialAccount` — receives exactly `amount`; the fee
  /// never touches this side.
  toFinancialAccountId   String

  amount    Decimal @db.Decimal(18, 2)
  /// Optional transfer fee, e.g. an MFS cash-out charge. Defaults to ৳0 —
  /// when zero, no Transfer Fee Expense line is posted at all.
  feeAmount Decimal @default(0) @db.Decimal(18, 2)

  transactionDate DateTime
  notes           String?

  createdById String
  createdAt   DateTime @default(now())

  farm                 Farm             @relation("FarmToTransfer", fields: [farmId], references: [id])
  fromFinancialAccount FinancialAccount @relation("FinancialAccountToTransferFrom", fields: [fromFinancialAccountId], references: [id])
  toFinancialAccount   FinancialAccount @relation("FinancialAccountToTransferTo", fields: [toFinancialAccountId], references: [id])

  @@index([farmId])
  @@index([farmId, fromFinancialAccountId])
  @@index([farmId, toFinancialAccountId])
  @@index([farmId, transactionDate])
}
