enum PaymentDirection {
  /// Money arriving into a `FinancialAccount` — e.g. settling a customer's
  /// receivable.
  INCOMING
  /// Money leaving a `FinancialAccount` — e.g. settling a supplier's payable
  /// or an unattached expense payment.
  OUTGOING
}

/// V2 payment method (RAKHAL-337, Finance V2 — `FINANCE_V2_DESIGN.md` §2,
/// §3). Deliberately **not** the V1 `FinancePaymentMethod` enum
/// (`prisma/schemas/finance/finance.enums.prisma`) — that one carries
/// `WALLET`, and `FINANCE_V2_DESIGN.md` §3 requires `WALLET` gone: "paying
/// from the wallet" becomes paying *from a specific `FinancialAccount`"
/// (the `financialAccountId` on `FinancePayment` already carries that
/// meaning, so a `WALLET` method value would be redundant with it, not just
/// deleted-enum hygiene). `BANK_TRANSFER`/`MFS` name *how* the money moved;
/// *which* bank or MFS account is `FinancePayment.financialAccountId`.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MFS
}

/// A single movement of money into or out of one `FinancialAccount`
/// (RAKHAL-337, Finance V2 — `FINANCE_V2_DESIGN.md` §4.5, §4.6, §6). One
/// payment always hits exactly one account; settling a document (a sale's
/// receivable, a purchase's payable) across several accounts — e.g. part
/// cash, part bKash, part bank — is modeled as *several* `FinancePayment`
/// rows, each with its own `PaymentAllocation` line(s), never one
/// `FinancePayment` spanning accounts.
///
/// **Named `FinancePayment`, not `Payment`** — a `Payment` model already
/// exists (`prisma/schemas/billing/payment.prisma`, RAKHAL-220's Rakhal
/// subscription-invoice payment-gateway record). Unrelated domain, but
/// Prisma model names are global across the schema, so this ticket's model
/// is prefixed to avoid the collision; the ticket's own AC text calls it
/// "Payment" conceptually, this is a naming-collision accommodation only.
///
/// Every `FinancePayment` posts a balanced `JournalTransaction` (via
/// `PaymentService.recordPayment` → `JournalService.postJournal`) in the
/// same `$transaction` as its own creation — see that service's doc comment
/// for the INCOMING/OUTGOING debit/credit sides and the standalone-payment
/// judgment call (posts against the generic Accounts Receivable/Payable
/// ledger accounts RAKHAL-333 already seeds, since the per-document
/// `Receivable`/`Payable` models don't exist until RAKHAL-340/348).
model FinancePayment {
  id     String @id @default(cuid())
  farmId String

  direction PaymentDirection

  /// The one `FinancialAccount` this payment hits. Must be active
  /// (`FinancialAccountService.assertAccountActive`) at the time of
  /// recording — an archived account cannot receive new transactions
  /// (`FINANCE_V2_DESIGN.md` §6).
  financialAccountId String

  amount Decimal @db.Decimal(18, 2)
  method PaymentMethod

  transactionDate DateTime
  referenceNumber String?
  notes           String?

  createdById String
  createdAt   DateTime @default(now())

  farm             Farm             @relation("FarmToFinancePayment", fields: [farmId], references: [id])
  financialAccount FinancialAccount @relation("FinancialAccountToFinancePayment", fields: [financialAccountId], references: [id])

  allocations PaymentAllocation[]

  @@index([farmId])
  @@index([farmId, financialAccountId])
  @@index([farmId, transactionDate])
}

/// Settles part or all of a payment against one outstanding document
/// (RAKHAL-337). **Many allocations per payment** (splitting one payment
/// across several open receivables) **and many payments per document**
/// (settling one receivable with several payments across different
/// accounts) are both supported — this table is the join.
///
/// `receivableId` is now a real `@relation` to `Receivable` (RAKHAL-340,
/// `prisma/schemas/finance-v2/receivable.prisma`) — closes the
/// `TODO(RAKHAL-340)` this column carried as a plain scalar since RAKHAL-337.
/// `payableId` is now also a real `@relation` to `Payable` (RAKHAL-348,
/// `prisma/schemas/purchasing/payable.prisma`) — closes the
/// `TODO(RAKHAL-348)` this column carried as a plain scalar since RAKHAL-337.
/// Exactly one of `receivableId`/`payableId` is expected to be set per row,
/// enforced in `PaymentService.allocatePayment` (application layer, not a DB
/// constraint — Postgres has no native "exactly one of N nullable FKs"
/// constraint short of a `CHECK` neither ticket added). `allocatePayment`
/// calls `ReceivableService.assertWithinOutstanding`/`closeIfSettled` for
/// `receivableId` lines (RAKHAL-340) and the mirroring `PayableService.
/// assertWithinOutstanding`/`closeIfSettled` for `payableId` lines
/// (RAKHAL-349, closing the gap this comment used to document).
model PaymentAllocation {
  id        String @id @default(cuid())
  paymentId String

  /// Real FK to `Receivable` (RAKHAL-340) — nullable because a row may
  /// instead carry `payableId`. `PaymentService.allocatePayment` still
  /// enforces "exactly one of the two" at the application layer.
  receivableId String?
  /// Real FK to `Payable` (RAKHAL-348) — nullable because a row may instead
  /// carry `receivableId`.
  payableId String?

  /// The portion of the parent `FinancePayment.amount` allocated to this
  /// document. `SUM(amount)` across a payment's allocations can never
  /// exceed that payment's own `amount` (`PaymentService.allocatePayment`);
  /// nor can `SUM(amount)` across a `Receivable`'s own allocations ever
  /// exceed that receivable's `totalAmount`
  /// (`ReceivableService`/`PaymentService.allocatePayment`, RAKHAL-340).
  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  payment    FinancePayment @relation(fields: [paymentId], references: [id])
  receivable Receivable?    @relation("ReceivableToPaymentAllocation", fields: [receivableId], references: [id], onDelete: Restrict)
  payable    Payable?       @relation("PayableToPaymentAllocation", fields: [payableId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([receivableId])
  @@index([payableId])
}
