enum EmailTemplate {
  WELCOME_EMAIL
  EMAIL_VERIFICATION
  PASSWORD_RESET
  VACCINATION_REMINDER
  SUBSCRIPTION_EXPIRY
  PAYMENT_RECEIPT
  PAYMENT_FAILED
  SUBSCRIPTION_RENEWAL
  FARM_REPORT
  OTP_VERIFICATION
  TEAM_INVITE
}

enum EmailStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

model EmailLog {
  id String @id

  to       String
  subject  String
  template EmailTemplate
  status   EmailStatus   @default(QUEUED)

  /// Idempotency anchor for transactional emails (RAKHAL-238). A stable key per
  /// (event, entity) makes a replayed trigger a no-op — the unique index is the
  /// race-safe guard. Null for non-transactional / fire-and-forget mails.
  idempotencyKey String? @unique

  provider String?

  tenantId String
  farmId   String?
  userId   String?

  retries       Int     @default(0)
  errorMessage  String?
  correlationId String?

  scheduledAt DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, farmId, userId])
  @@index([status, createdAt])
}
