/// Task Hub task (PRD §17, §24.13). The same record is surfaced in the Task Hub
/// and (when category = HEALTHCARE) the Healthcare task tab. Created either by a
/// user (`source = MANUAL`) or programmatically by another module
/// (`SYSTEM_AUTO` / `HEALTH_PLAN`) via the internal create API (RAKHAL-097).
model Task {
  id        String @id @default(cuid())
  farmId    String
  reference String // human ref, e.g. TSK-001 (sequential per farm)

  name     String
  details  String?
  category TaskCategory @default(GENERAL)
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(PENDING)

  dueAt DateTime

  /// Checklist sub-steps: [{ "id": "...", "text": "...", "completed": false }].
  steps Json?

  recurring         Boolean         @default(false)
  recurrenceType    TaskRecurrence?
  recurrenceEndDate DateTime?

  safetyCritical Boolean    @default(false)
  source         TaskSource @default(MANUAL)

  relatedCattleId String?

  /// RAKHAL-299: edit substrate — the domain event this task was generated
  /// from (e.g. "BREEDING_EVENT", "CALVING_EVENT"), paired with `sourceEventId`.
  /// The only prior handle was a fuzzy `{relatedCattleId, source, category}`
  /// triple that would reschedule unrelated tasks. Nullable — manual tasks
  /// (`source: MANUAL`) have no source event. Not a Prisma enum: spans event
  /// types across modules (reproduction/health/calf/...), so a plain string
  /// discriminator avoids importing every module's enums into this shared model.
  sourceEventType String?
  sourceEventId   String?

  assignedToId       String?
  completionPhotoUrl String?
  completedById      String?
  completedAt        DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm  @relation("FarmToTask", fields: [farmId], references: [id])
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@unique([farmId, reference])
  @@index([farmId, status])
  @@index([assignedToId])
  @@index([dueAt])
  @@index([category])
  @@index([sourceEventType, sourceEventId])
}
