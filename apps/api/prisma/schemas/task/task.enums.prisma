enum TaskCategory {
  FEEDING
  HEALTHCARE
  BREEDING
  MAINTENANCE
  MILKING
  CALF_CARE
  GENERAL
  /// DEPRECATED (RAKHAL-491): reminders are `Task.kind = REMINDER` now; never written. Kept because dropping an enum value needs a hand-authored migration (TECH_DEBT).
  REMINDER
}

/// RAKHAL-491: a custom reminder (title, notes, repeat, recipients) is delivered by the daily follow-up
/// sweep; a TASK is work to do. One table, split by this column.
enum TaskKind {
  TASK
  REMINDER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

/// Stored status. "Overdue" is derived (not stored): a non-completed task whose
/// dueAt has passed is presented as overdue (PRD §17).
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum TaskSource {
  MANUAL
  HEALTH_PLAN
  SYSTEM_AUTO
}

enum TaskRecurrence {
  DAILY
  WEEKLY
  MONTHLY
  /// RAKHAL-487: repeats every `Task.recurrenceIntervalDays` days.
  EVERY_N_DAYS
}

/// Task Hub activity/history section (user request, no ticket #). CREATED is never stored as a row
/// here — synthesized in `TaskService#present` from the task's own `createdBy`/`createdAt`, which
/// already carry that information.
enum TaskAuditAction {
  UPDATED
  COMPLETED
  REOPENED
  CANCELLED
}
