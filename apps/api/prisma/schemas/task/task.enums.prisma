enum TaskCategory {
  FEEDING
  HEALTHCARE
  BREEDING
  MAINTENANCE
  MILKING
  CALF_CARE
  GENERAL
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

/// Stored status. "Overdue" is derived (not stored): a non-completed task whose
/// dueAt has passed is presented as overdue (PRD §17).
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskSource {
  MANUAL
  HEALTH_PLAN
  SYSTEM_AUTO
}

enum TaskRecurrence {
  DAILY
  WEEKLY
  MONTHLY
}
