/// Finance Module enums (PRD §16). RAKHAL-354: `FinanceTxnType`/
/// `FinanceCategory`/`FinancePaymentMethod`/`FinancePaymentType`/
/// `FinanceTxnStatus`/`ReceivableKind`/`ReceivableStatus`/`WalletDirection`
/// dropped along with `FinanceTransaction`/`FinanceReceivable`/
/// `WalletTransaction` (see `finance.prisma`'s doc comment). Fields that used
/// to carry `FinancePaymentMethod` (`BreedingEvent.paymentMethod`,
/// `FeedConcentrationService.finalize`'s payment param) now use Finance V2's
/// own `PaymentMethod` (`prisma/schemas/finance-v2/payment.prisma`, already
/// WALLET-less) instead of a parallel duplicate enum. Only `LoanStatus`
/// (`FinanceLoan`) and `FixedAssetCategory` (`FixedAsset`) survive — both
/// models are explicitly kept, see `finance.prisma`.

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum FixedAssetCategory {
  EQUIPMENT
  VEHICLE
  BUILDING
  OTHER
}
