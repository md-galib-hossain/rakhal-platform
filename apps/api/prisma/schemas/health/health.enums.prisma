  TREATMENT
  PREVENTION
  BREEDING
  VACCINATION
  DEWORMING
  ROUTINE
}

enum HealthPlanType {
  MEDICAL
  PREVENTION
  BREEDING
  GENERAL
}

enum HealthActionType {
  MEDICINE
  OBSERVATION
  VACCINATION
  DEWORMING
  CHECKUP
  LAB_TEST
  OTHER
}

enum MedicineRoute {
  IM
  IV
  SC
  ORAL
  TOPICAL
  OTHER
