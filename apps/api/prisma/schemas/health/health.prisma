model HealthCase {
  id       String @id @default(cuid())
  farmId   String
  cattleId String

  caseCode      String
  diagnosis     String
  /// RAKHAL-275: structured condition bucket, additive/nullable — `diagnosis`
  /// stays the free-text detail field (required for OTHER too).
  condition     HealthCondition?
  diagnosisType HealthDiagnosisType
  priority      HealthPriority
  status        HealthCaseStatus    @default(ACTIVE)

  shedId   String?
  shedName String?

  reportedBy  String?
  assignedVet String?

  startDate            DateTime  @default(now())
  expectedRecoveryDate DateTime?
  closedDate           DateTime?
  closeReason          String?
  mortalityId          String?
  healthPlanId         String?

  currentStep        Int @default(0)
  totalSteps         Int @default(0)
  progressPercentage Int @default(0)

  symptoms String[]
  notes    String?
  /// Photo of the affected area (PRD §8.7). URL only — binary upload is blocked
  /// on the object-storage decision.
  photoUrl String?

  isSafetyWithholdingActive Boolean   @default(false)
  milkWithdrawalUntil       DateTime?
  meatWithdrawalUntil       DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm        @relation("FarmToHealthCase", fields: [farmId], references: [id])
  cattle     Cattle      @relation(fields: [cattleId], references: [id])
  shed       Shed?       @relation(fields: [shedId], references: [id])
  healthPlan HealthPlan? @relation(fields: [healthPlanId], references: [id])

  tasks             HealthTask[]
  treatmentLogs     TreatmentLog[]
  healthUpdates     HealthUpdate[]
  mortalityRecord   MortalityRecord?
  safetyWithdrawals SafetyWithdrawal[]

  @@unique([farmId, caseCode])
  @@index([farmId, cattleId])
  @@index([farmId, status])
  @@index([farmId, diagnosis])
  @@index([farmId, condition])
  @@index([farmId, priority])
  @@index([farmId, startDate])
}

model HealthPlan {
  id     String @id @default(cuid())
  farmId String

  name        String
  category    HealthPlanCategory
  planType    HealthPlanType
  description String?
  diagnosis   String?

  cycleLengthDays            Int?
  totalActionSteps           Int      @default(0)
  successRate                Decimal?
  currentlyActiveAnimalCount Int      @default(0)

  isTemplate Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  farm    Farm @relation("FarmToHealthPlan", fields: [farmId], references: [id])
  creator User @relation("HealthPlanCreator", fields: [createdBy], references: [id])

  steps HealthPlanStep[]
  cases HealthCase[]
  tasks HealthTask[]

  @@unique([farmId, name])
  @@index([farmId, category])
  @@index([farmId, name])
}

model HealthPlanStep {
  id           String @id @default(cuid())
  healthPlanId String

  dayNumber  Int
  title      String
  actionType HealthActionType

  medicineId   String?
  medicineName String?
  doseAmount   Decimal?
  doseUnit     String?
  route        MedicineRoute?

  instruction        String?
  estimatedTime      String?
  milkWithdrawalDays Int?
  meatWithdrawalDays Int?
  isRequired         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthPlan HealthPlan @relation(fields: [healthPlanId], references: [id])

  @@index([healthPlanId])
  @@index([healthPlanId, dayNumber])
}

model HealthTask {
  id           String  @id @default(cuid())
  farmId       String
  cattleId     String
  healthCaseId String
  healthPlanId String?

  taskCode    String
  taskDate    DateTime
  dueDateTime DateTime
  status      HealthTaskStatus @default(PENDING)
  taskType    HealthActionType

  title       String
  instruction String?
  stepNumber  Int?
  totalSteps  Int?

  medicineId   String?
  medicineName String?
  doseAmount   Decimal?
  doseUnit     String?
  route        MedicineRoute?

  completedAt DateTime?
  completedBy String?

  rescheduledFrom DateTime?
  rescheduledTo   DateTime?
  notes           String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm        @relation("FarmToHealthTask", fields: [farmId], references: [id])
  cattle     Cattle      @relation(fields: [cattleId], references: [id])
  healthCase HealthCase  @relation(fields: [healthCaseId], references: [id])
  healthPlan HealthPlan? @relation(fields: [healthPlanId], references: [id])

  treatmentLogs TreatmentLog[]

  @@unique([farmId, taskCode])
  @@index([farmId, dueDateTime])
  @@index([farmId, status])
  @@index([farmId, cattleId])
  @@index([farmId, healthCaseId])
}

model TreatmentLog {
  id           String  @id @default(cuid())
  farmId       String
  cattleId     String
  healthCaseId String
  healthTaskId String?

  medicineId   String?
  medicineName String?
  route        MedicineRoute?
  doseAmount   Decimal?
  doseUnit     String?

  administeredAt DateTime
  administeredBy String

  stockDeducted          Boolean  @default(false)
  stockDeductionQuantity Decimal?
  batchNo                String?
  notes                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm        @relation("FarmToTreatmentLog", fields: [farmId], references: [id])
  cattle     Cattle      @relation(fields: [cattleId], references: [id])
  healthCase HealthCase  @relation(fields: [healthCaseId], references: [id])
  healthTask HealthTask? @relation(fields: [healthTaskId], references: [id])

  safetyWithdrawals SafetyWithdrawal[]

  @@index([farmId, cattleId])
  @@index([farmId, healthCaseId])
  @@index([farmId, administeredAt])
}

model HealthUpdate {
  id           String @id @default(cuid())
  farmId       String
  cattleId     String
  healthCaseId String

  clinicalProgress ClinicalProgress
  symptoms         String[]
  temperature      Decimal?
  appetite         AppetiteStatus?
  appearance       AppearanceStatus?
  observation      String?
  recordedBy       String
  recordedAt       DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm       @relation("FarmToHealthUpdate", fields: [farmId], references: [id])
  cattle     Cattle     @relation(fields: [cattleId], references: [id])
  healthCase HealthCase @relation(fields: [healthCaseId], references: [id])

  @@index([farmId, healthCaseId])
  @@index([farmId, cattleId])
  @@index([farmId, recordedAt])
}

model MortalityRecord {
  id           String @id @default(cuid())
  farmId       String
  cattleId     String
  healthCaseId String @unique

  deathDate           DateTime
  primaryCauseOfDeath String
  vetSignOff          String?
  symptoms            String[]
  postMortemPerformed Boolean  @default(false)
  disposalMethod      String?
  disposalCost        Decimal?
  disposalLocation    String?
  additionalNotes     String?
  recordedBy          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm       @relation("FarmToMortalityRecord", fields: [farmId], references: [id])
  cattle     Cattle     @relation(fields: [cattleId], references: [id])
  healthCase HealthCase @relation(fields: [healthCaseId], references: [id])

  @@index([farmId, cattleId])
  @@index([farmId, healthCaseId])
  @@index([farmId, deathDate])
}

model SafetyWithdrawal {
  id             String  @id @default(cuid())
  farmId         String
  cattleId       String
  healthCaseId   String
  treatmentLogId String?
  medicineId     String?

  milkWithdrawalUntil DateTime?
  meatWithdrawalUntil DateTime?
  status              SafetyWithdrawalStatus @default(ACTIVE)
  safeMilkDate        DateTime?
  safeMeatDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm         Farm          @relation("FarmToSafetyWithdrawal", fields: [farmId], references: [id])
  cattle       Cattle        @relation(fields: [cattleId], references: [id])
  healthCase   HealthCase    @relation(fields: [healthCaseId], references: [id])
  treatmentLog TreatmentLog? @relation(fields: [treatmentLogId], references: [id])

  @@index([farmId, cattleId])
  @@index([farmId, status])
  @@index([farmId, healthCaseId])
}

model DiseaseCatalog {
  id     String  @id @default(cuid())
  farmId String?

  name            String
  category        String?
  defaultPriority HealthPriority?
  defaultSymptoms String[]

  isContagious              Boolean @default(false)
  recommendedIsolation      Boolean @default(false)
  defaultMilkWithdrawalDays Int?
  defaultMeatWithdrawalDays Int?
  isSystemDefault           Boolean @default(false)
  isActive                  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm Farm? @relation("FarmToDiseaseCatalog", fields: [farmId], references: [id])

  @@index([farmId])
  @@index([name])
}
