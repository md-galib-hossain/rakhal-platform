model Session {
  id                  String   @id @default(cuid())

  userId              String

  status              SessionStatus @default(ACTIVE)

  ipAddress           String?
  userAgent           String?
  deviceName          String?

  expiresAt           DateTime

  lastUsedAt          DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User @relation(fields: [userId], references: [id])

  refreshTokens       RefreshToken[]

  @@index([userId])
}