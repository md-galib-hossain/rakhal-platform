model RefreshToken {
  id                    String   @id @default(cuid())

  sessionId             String

  tokenHash             String

  tokenFamily           String

  parentTokenId         String?

  replacedByTokenId     String?

  isRevoked             Boolean  @default(false)

  revokedAt             DateTime?

  expiresAt             DateTime

  createdAt             DateTime @default(now())

  session               Session @relation(fields: [sessionId], references: [id])

  parentToken           RefreshToken? @relation(
    "TokenRotation",
    fields: [parentTokenId],
    references: [id]
  )

  replacedByToken       RefreshToken? @relation(
    "TokenRotation",
    fields: [replacedByTokenId],
    references: [id]
  )

  nextTokens            RefreshToken[] @relation("TokenRotation")

  @@index([sessionId])
  @@index([tokenFamily])
}