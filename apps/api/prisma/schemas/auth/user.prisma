model User {
  id String @id @default(cuid())

  email String @unique
  name  String

  passwordHash String?

  isEmailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  isBlocked       Boolean @default(false)

  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  lastLoginAt           DateTime?
  lastPasswordChangedAt DateTime?

  permissionsVersion Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions      Session[]
  oauthAccounts OAuthAccount[]

  authTokens AuthToken[]

  mfa UserMFA?

  ownedFarms          Farm[]       @relation("FarmOwner")
  farmMembers         FarmMember[]
  sentFarmInvitations FarmMember[] @relation("FarmInvitations")
  auditLogs           AuditLog[]   @relation("UserToAuditLog")

  @@index([email])
}
