# Production env for the single-VPS stack. Copy to .env.prod ON THE SERVER (root-only, chmod 600). Never commit it.
# Keep a copy of this file's real values in your password manager: a lost VPS must not mean lost secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Images (built by .github/workflows/images.yml; the VPS only pulls) ----
# Deploy a specific commit: IMAGE_TAG=sha-<first 7 chars>. Rollback = set the previous sha tag and redeploy.
IMAGE_REGISTRY=ghcr.io/md-galib-hossain
IMAGE_TAG=latest

# ---- Domains (Cloudflare proxied, SSL mode Full (strict)) ----
FARM_DOMAIN=farm.rakhal.app
ADMIN_DOMAIN=admin.rakhal.app
API_DOMAIN=api.rakhal.app
ACME_EMAIL=you@example.com
WEB_PUBLIC_URL=https://farm.rakhal.app
FARM_PUBLIC_URL=https://farm.rakhal.app
# ADMIN_ALLOW_CIDR=203.0.113.10/32   (then uncomment the block in docker/Caddyfile)

# ---- Database (container; never published to the host) ----
POSTGRES_USER=rakhal
POSTGRES_PASSWORD=
POSTGRES_DB=rakhal
DB_POOL_SIZE=20

# API runtime secrets (JWT, email, image-upload R2, Sentry...) live in a SEPARATE file: .env.api
# (copy .env.api.example). Keeping them apart means the API container never sees the backup R2 keys,
# so a compromised API cannot delete your backups. Path override: API_ENV_FILE.
TRUST_PROXY_HOPS=2

# ---- Backups: SEPARATE private R2 bucket + SEPARATE token scoped to that bucket only ----
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=rakhal-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# age PUBLIC key (starts with "age1..."). Create the pair on your laptop:  age-keygen -o rakhal-backup.key
# Put the PUBLIC key here; store the private key file ONLY in your password manager, never on the server.
AGE_PUBLIC_KEY=
# healthchecks.io (or similar) ping URL: alerts you when a nightly backup does not report in
BACKUP_HEALTHCHECK_URL=
BACKUP_CRON=0 2 * * *
KEEP_DAILY_DAYS=30
KEEP_MONTHLY_DAYS=365

# ---- Optional ----
# SENTRY_DSN=
# SENTRY_ENABLED=true
