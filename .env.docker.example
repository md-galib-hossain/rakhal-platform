# Compose-level vars. Copy to .env.docker (gitignored via .env.*) and fill in. Never commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

POSTGRES_USER=rakhal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rakhal
POSTGRES_HOST_PORT=5433

# Public origins (also CORS allowlist; API refuses to boot in production without ALLOWED_ORIGINS)
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3010
WEB_PUBLIC_URL=http://localhost:3005
FARM_PUBLIC_URL=http://localhost:3005
TRUST_PROXY_HOPS=1

# Host ports (change if a local dev server already uses them)
API_HOST_PORT=5005
WEB_HOST_PORT=3005
ADMIN_HOST_PORT=3010

# Required by env.schema.ts (email links point at the web app)
EMAIL_FROM=no-reply@rakhal.test
EMAIL_VERIFICATION_BASE_URL=http://localhost:3005/verify-email
EMAIL_PASSWORD_RESET_BASE_URL=http://localhost:3005/reset-password

# --- API secrets (read by apps/api env.schema.ts; JWT secrets need >= 32 chars) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
AUTH_CSRF_SECRET=
SESSION_SECRET=

# Cookies over plain http on localhost
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_CSRF_COOKIE_SECURE=false

# Storage: `memory` for local; `r2` in prod requires R2_* below
STORAGE_PROVIDER=memory
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Resend client is built at boot and throws without a key. Any placeholder boots; mail will not send.
RESEND_API_KEY=re_local_placeholder

# Optional integrations (see apps/api/.env for the full key list)
# SENTRY_DSN=
# BKASH_*  TELEGRAM_*
