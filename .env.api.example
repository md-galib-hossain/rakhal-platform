# API runtime env (loaded into the api container only). Copy to .env.api ON THE SERVER (chmod 600). Never commit it.
# Compose-level settings (domains, image tag, Postgres password, backups) live in .env.prod, NOT here.
# Keep a copy of the real values in your password manager.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Auth secrets (>= 32 chars each, all different) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
AUTH_CSRF_SECRET=
SESSION_SECRET=
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_CSRF_COOKIE_SECURE=true

# ---- Email (Resend) ----
EMAIL_FROM=no-reply@rakhal.app
RESEND_API_KEY=

# ---- Image uploads: its OWN R2 bucket + token (NOT the backup bucket) ----
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---- Optional (see apps/api/src/core/config/env/env.schema.ts for the full list) ----
# SENTRY_DSN=
# SENTRY_ENABLED=true
# BKASH_*  TELEGRAM_*
